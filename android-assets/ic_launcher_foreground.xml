<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive Icon Foreground for V-Taper Athlete (Android 8.0+ / API 26+) -->
<!-- Centered with scale 0.65 to fit within the 72dp circular/squircle safe zone -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="600"
    android:viewportHeight="600">

    <group
        android:pivotX="300"
        android:pivotY="300"
        android:scaleX="0.65"
        android:scaleY="0.65">

        <!-- Outer Reticle Ring 1 -->
        <path
            android:pathData="M300,50 A250,250 0 1,0 300,550 A250,250 0 1,0 300,50 Z"
            android:strokeColor="#FF8B0A1F"
            android:strokeWidth="2.5" />

        <!-- Inner Reticle Ring 2 -->
        <path
            android:pathData="M300,62 A238,238 0 1,0 300,538 A238,238 0 1,0 300,62 Z"
            android:strokeColor="#66C8102E"
            android:strokeWidth="1.2" />

        <!-- 4 Cardinal Alignment Marks -->
        <path
            android:pathData="M300,50 L300,30 M300,550 L300,570 M550,300 L570,300 M50,300 L30,300"
            android:strokeColor="#FFC8102E"
            android:strokeWidth="3"
            android:strokeLineCap="round" />

        <!-- Left Athletic Tape Band (Linear Gradient Shader) -->
        <path
            android:pathData="M186,160 L222,160 L300,296.5 L300,440 L162.8,199.9 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="186"
                    android:startY="160"
                    android:endX="300"
                    android:endY="440">
                    <item android:color="#FFD91B3A" android:offset="0.0" />
                    <item android:color="#FFC8102E" android:offset="0.55" />
                    <item android:color="#FF8B0A1F" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Right Athletic Tape Band (Linear Gradient Shader) -->
        <path
            android:pathData="M414,160 L378,160 L300,296.5 L300,440 L437.2,199.9 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="414"
                    android:startY="160"
                    android:endX="300"
                    android:endY="440">
                    <item android:color="#FFC8102E" android:offset="0.0" />
                    <item android:color="#FFA50D26" android:offset="0.6" />
                    <item android:color="#FF6E0818" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Left 3D Bevel Fold -->
        <path
            android:pathData="M186,160 L162.8,199.9 L208.8,199.9 Z"
            android:fillColor="#FF8B0A1F" />

        <!-- Right 3D Bevel Fold -->
        <path
            android:pathData="M414,160 L437.2,199.9 L391.2,199.9 Z"
            android:fillColor="#FF8B0A1F" />

        <!-- Specular Edge Highlights -->
        <path
            android:pathData="M186,160 L162.8,199.9 M414,160 L437.2,199.9 M162.8,199.9 L300,440 M437.2,199.9 L300,440 M300,296.5 L300,440"
            android:strokeColor="#CCE8E8E8"
            android:strokeWidth="1.6"
            android:strokeLineCap="round" />

        <!-- Internal Tape Seam -->
        <path
            android:pathData="M212.4,215 L300,368.3 M387.6,215 L300,368.3"
            android:strokeColor="#990A0A0A"
            android:strokeWidth="1.8"
            android:strokeLineCap="round" />
    </group>
</vector>
